# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these under Project Settings -> Environment Variables.

# Optional. Server-side only (no NEXT_PUBLIC_ prefix, never exposed to the browser).
# When set, POST /api/contact forwards each validated submission as JSON to this URL,
# e.g. a Formspree endpoint: https://formspree.io/f/your-form-id
# When empty or unset, the route only logs the submission on the server and still succeeds.
CONTACT_FORM_ENDPOINT=
